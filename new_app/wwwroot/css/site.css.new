/* Please see documentation at https://docs.microsoft.com/aspnet/core/client-side/bundling-and-minification
for details on configuring this project to bundle and minify static web assets. */

:root {
  --bs-primary: #0d6efd;
  --bs-secondary: #6c757d;
  --soap-service-color: #17a2b8;
}

/* Global styles */
html {
  position: relative;
  min-height: 100%;
  font-size: 16px;
}

body {
  margin-bottom: 60px; /* Margin bottom by footer height */
  padding-top: 0; /* Remove Bootstrap 3/4 fixed header padding */
}

/* Main container styles */
.container {
  padding: 0 15px;
  max-width: 1200px;
}

/* Modern footer positioning */
.footer {
  position: absolute;
  bottom: 0;
  width: 100%;
  height: 60px; /* Fixed height footer */
  line-height: 60px; /* Vertically center text */
  background-color: #f5f5f5;
}

/* Card styles for SOAP service documentation */
.soap-service-card {
  border-left: 4px solid var(--soap-service-color);
  margin-bottom: 1.5rem;
  box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
  transition: all 0.3s ease;
}

.soap-service-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
}

.soap-service-title {
  color: var(--soap-service-color);
  font-weight: 600;
}

.soap-endpoint {
  font-family: monospace;
  background-color: #f8f9fa;
  padding: 0.5rem;
  border-radius: 0.25rem;
  border: 1px solid #dee2e6;
}

/* Form styles with Bootstrap 5 compatibility */
.form-group {
  margin-bottom: 1rem;
}

/* Button improvements */
.btn {
  border-radius: 0.25rem;
}

/* Responsive styles */
@media (max-width: 768px) {
  html {
    font-size: 14px;
  }
  
  .soap-endpoint {
    word-break: break-all;
  }
  
  .container {
    padding: 0 10px;
  }
  
  .display-4 {
    font-size: 2rem;
  }
  
  .table-responsive {
    overflow-x: auto;
  }
  
  /* Improve spacing on small screens */
  .mt-sm-2 {
    margin-top: 0.5rem !important;
  }
  
  .mb-sm-2 {
    margin-bottom: 0.5rem !important;
  }
}

/* Print styles for better documentation printing */
@media print {
  .soap-endpoint {
    background-color: transparent !important;
    border: 1px solid #000;
  }
  
  .footer {
    position: fixed;
  }
  
  .no-print {
    display: none !important;
  }
}

/* Accessibility improvements */
.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* Dark mode support - requires dark mode class on body */
.dark-mode {
  --bs-body-bg: #212529;
  --bs-body-color: #f8f9fa;
}

.dark-mode .card {
  background-color: #343a40;
  border-color: #495057;
}

.dark-mode .soap-endpoint {
  background-color: #343a40;
  border-color: #495057;
  color: #f8f9fa;
}

.dark-mode .table {
  color: #f8f9fa;
}